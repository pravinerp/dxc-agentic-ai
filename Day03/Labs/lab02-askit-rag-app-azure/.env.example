# AWS Bedrock is the MAIN provider: the AWS keys and BEDROCK_SMALL_MODEL_ID come from the course .env
# in the Participants folder (the trainer shares it). Nothing to add here for Bedrock.

# Azure AI Foundry (optional): put these in the SAME course .env, like the AWS keys
AZURE_OPENAI_API_KEY=
# resource endpoint, e.g. https://director-9575-resource.services.ai.azure.com (the Foundry "Project endpoint" also works)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com
# chat models = DEPLOYMENT names, comma separated, first one is the default (the sidebar lets you pick or type another)
AZURE_OPENAI_CHAT_DEPLOYMENTS=gpt-5.6-luna-1,Kimi-K2.5
# OPTIONAL embedding deployment (e.g. Cohere-Embed-V5-Pro). Leave EMPTY = embeddings run locally (fastembed)
AZURE_OPENAI_EMBED_DEPLOYMENT=

# OPTIONAL backup: an OpenAI key (you can also paste it in the app sidebar)
OPENAI_API_KEY=
